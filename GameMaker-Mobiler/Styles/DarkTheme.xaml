<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="ColorBackground">#FF000000</Color>
    <Color x:Key="ColorHeaderStart">#FF090909</Color>
    <Color x:Key="ColorHeaderEnd">#FF101827</Color>
    <Color x:Key="ColorSurface">#FF111111</Color>
    <Color x:Key="ColorSurfaceAlt">#FF1A1A1A</Color>
    <Color x:Key="ColorSurfaceRaised">#FF222222</Color>
    <Color x:Key="ColorBorder">#FF333333</Color>
    <Color x:Key="ColorPrimary">#FF60A5FA</Color>
    <Color x:Key="ColorPrimaryHover">#FF3B82F6</Color>
    <Color x:Key="ColorSecondaryHover">#FF2A3442</Color>
    <Color x:Key="ColorAccent">#FF2DD4BF</Color>
    <Color x:Key="ColorSuccess">#FF22C55E</Color>
    <Color x:Key="ColorWarning">#FFFBBF24</Color>
    <Color x:Key="ColorTextPrimary">#FFE5EDF7</Color>
    <Color x:Key="ColorTextSecondary">#FFA9B6C7</Color>
    <Color x:Key="ColorTextMuted">#FF728196</Color>
    <Color x:Key="ColorOnPrimary">#FF07111F</Color>
    <Color x:Key="ColorProgressTrack">#FF2A2A2A</Color>
    <Color x:Key="ColorScrollBarTrack">#FF181818</Color>
    <Color x:Key="ColorScrollBarThumb">#FF4A4A4A</Color>
    <Color x:Key="ColorScrollBarThumbHover">#FF666666</Color>
    <Color x:Key="ColorLogBackground">#FF050505</Color>

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource ColorBackground}" />
    <LinearGradientBrush x:Key="HeaderBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource ColorHeaderStart}" Offset="0" />
        <GradientStop Color="{StaticResource ColorHeaderEnd}" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource ColorSurface}" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="{StaticResource ColorSurfaceAlt}" />
    <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="{StaticResource ColorSurfaceRaised}" />
    <SolidColorBrush x:Key="BorderBrushTheme" Color="{StaticResource ColorBorder}" />
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource ColorPrimary}" />
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="{StaticResource ColorPrimaryHover}" />
    <SolidColorBrush x:Key="SecondaryHoverBrush" Color="{StaticResource ColorSecondaryHover}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource ColorAccent}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource ColorSuccess}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource ColorWarning}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource ColorTextPrimary}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource ColorTextSecondary}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource ColorTextMuted}" />
    <SolidColorBrush x:Key="OnPrimaryBrush" Color="{StaticResource ColorOnPrimary}" />
    <SolidColorBrush x:Key="ProgressTrackBrush" Color="{StaticResource ColorProgressTrack}" />
    <SolidColorBrush x:Key="ScrollBarTrackBrush" Color="{StaticResource ColorScrollBarTrack}" />
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="{StaticResource ColorScrollBarThumb}" />
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="{StaticResource ColorScrollBarThumbHover}" />
    <SolidColorBrush x:Key="LogBackgroundBrush" Color="{StaticResource ColorLogBackground}" />
</ResourceDictionary>
